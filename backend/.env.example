#DEVMODE=enabled
APPSECRET=KoudPils
#DEFAULT_USER=
#DEFAULT_PASS=
DB_HOST=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
PORT=3000
# passkeys are bound to these; unset they come from the request
#RP_ID=pils.oscarr.nl
#RP_ORIGIN=https://pils.oscarr.nl

# single sign-on. Unset, the login page simply does not offer it.
# a public client with PKCE, so there is deliberately no client secret here
#OIDC_ISSUER=https://auth.oscarr.nl
#OIDC_CLIENT_ID=pils
#OIDC_NAME=auth.oscarr.nl
# defaults to RP_ORIGIN + /api/v1/users/login/oidc/callback, and has to match
# the redirect uri registered with the issuer exactly
#OIDC_REDIRECT_URI=
#OIDC_SCOPES=openid profile email groups
#OIDC_USERNAME_CLAIM=preferred_username
# a group from the groups claim whose members are admins here
#OIDC_ADMIN_GROUP=
# set to false to only let subjects that already have an account sign in
#OIDC_ALLOW_SIGNUP=
# set to true to let a first federated sign-in claim the local account that
# already answers to its username. Only where the issuer's usernames are as
# trustworthy as this site's own: whoever can pick one upstream picks the
# account they land in here, admin flag included
#OIDC_LINK_BY_USERNAME=
